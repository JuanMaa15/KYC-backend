{
  "name": "kyc-backend",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "postinstall": "prisma generate",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --coverage.include=\"src/**\" --coverage.exclude=\"**/generated/**\" --coverage.exclude=\"src/providers/**\" --coverage.exclude=\"src/app.ts\" --coverage.exclude=\"src/index.ts\" --coverage.exclude=\"src/config/env.ts\" --coverage.exclude=\"src/database/prismaService.ts\" --coverage.exclude=\"src/share/errors.ts\" --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "db:generate": "prisma generate",
    "db:migrate": "wrangler d1 migrations apply kyc-db",
    "db:studio": "prisma studio",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "prepare": "husky"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@prisma/adapter-d1": "^7.6.0",
    "@prisma/client": "^7.6.0",
    "hono": "^4.12.27",
    "zod": "^3.25.71"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^26.1.0",
    "@typescript-eslint/eslint-plugin": "^8.35.1",
    "@typescript-eslint/parser": "^8.35.1",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^9.0.0",
    "husky": "^9.1.7",
    "prisma": "^7.6.0",
    "typescript-eslint": "^8.35.1",
    "vitest": "^3.2.4",
    "wrangler": "^4.4.0"
  }
}
